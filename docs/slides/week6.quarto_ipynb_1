    "ax.axhline(1.0, color=\"gray\", linestyle=\"--\", alpha=0.5)\n",
    "ax.set_ylabel(\"Residual\")\n",
    "ax.set_title(\"Residuals (multiplicative: ideal noise ≈ 1.0)\")\n",
    "plt.tight_layout()"
