docs/css/quarto-reveal-*.css
docs/slides/.*-pdf-export.html
docs/slides/week*_files/
docs/slides/*.html
docs/slides/*.pdf
docs/slides/_libs/
# Executed slide notebooks ARE committed (students reference the code), so keep
# them tracked even though the rest of the rendered slide output is ignored above.
!docs/slides/*.ipynb
# The slides index is a maintained source file (not a build artifact).
!docs/slides/index.html
syllabus_source/.tmp-build/

