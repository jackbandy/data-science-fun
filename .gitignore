sandbox/**/*.pdf

# Python
__pycache__/
*.py[cod]
.env
.venv/
*.ipynb_checkpoints/

# Quarto (Ethics in Data Science mini-book)
docs/ethics-in-data-science/.quarto/
docs/ethics-in-data-science/**/*.quarto_ipynb
docs/ethics-in-data-science/book/
docs/ethics-in-data-science/*_files/

# Quarto slides (rendered artifacts — built by CI, not committed)
docs/slides/.quarto/
docs/slides/**/*.quarto_ipynb*
docs/slides/_quarto_internal_scss_error.scss
docs/css/quarto-reveal-*.css
docs/slides/.*-pdf-export.html
docs/slides/week*_files/
docs/slides/*.html
docs/slides/*.pdf
docs/slides/_libs/
# Executed slide notebooks ARE committed (students reference the code), so keep
# them tracked even though the rest of the rendered slide output is ignored above.
!docs/slides/*.ipynb
# The slides index is a maintained source file (not a build artifact).
!docs/slides/index.html
syllabus_source/.tmp-build/

# Prompt scratch files
prompts.txt

